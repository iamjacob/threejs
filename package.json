{
  "name": "threejs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "npm run sqlwasm && vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "npm run sqlwasm && vite build",
    "sqlwasm": "node scripts/copy-sql-wasm.mjs",
    "db:generate": "drizzle-kit generate && node scripts/bundle-migrations.mjs",
    "test:data": "node --test tests/data-*.test.mjs",
    "test:web-restart": "node tests/browser/web-restart.mjs",
    "test:shared-device": "node tests/browser/shared-device.mjs",
    "test:android:people": "npm run cap:sync && cd android && ./gradlew assembleDebug -q && adb install -r app/build/outputs/apk/debug/app-debug.apk && cd .. && node tests/browser/android-shared-device.mjs",
    "test:game": "node --test tests/game-*.test.mjs",
    "build:test": "VITE_BOOOKS_TEST_HOOKS=1 npm run build",
    "test:map-play": "node tests/browser/map-play.mjs",
    "test:android:play": "VITE_BOOOKS_TEST_HOOKS=1 npm run cap:sync && cd android && ./gradlew assembleDebug -q && adb install -r app/build/outputs/apk/debug/app-debug.apk && cd .. && node tests/browser/android-map-play.mjs",
    "build:native": "npm run sqlwasm && vite build --mode native",
    "cap:sync": "npm run build:native && cap sync",
    "test:android": "VITE_BOOOKS_TEST_HOOKS=1 npm run cap:sync && cd android && ./gradlew assembleDebug -q && adb install -r app/build/outputs/apk/debug/app-debug.apk && cd .. && node tests/browser/android-restart.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && tsc --noEmit && tsc --project tsconfig.worker.json",
    "test:shelf": "node --test tests/shelf-controls.test.mjs tests/shelf-growth.test.mjs tests/book-long-press.test.mjs tests/book-drag.test.mjs",
    "test:scanner": "node --test tests/scanner.test.mjs tests/scanner-integration.test.mjs tests/corner-detector.test.mjs tests/scanner-detection-session.test.mjs tests/scan-drafts.test.mjs tests/book-enrichment.test.mjs tests/loupe-placement.test.mjs",
    "test:browsing": "node --test tests/book-browsing.test.mjs tests/center-camera.test.mjs",
    "test:reader": "node --test tests/reader-startup.test.mjs tests/reader-fullscreen.test.mjs tests/book-browsing.test.mjs tests/shake.test.mjs",
    "test:helix": "node --test tests/helix-navigation.test.mjs",
    "test:paths": "node --test tests/paths.test.mjs",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "images": "node scripts/generate-book-images.mjs",
    "atlas": "node scripts/generate-cover-atlas.mjs",
    "test:atlas": "node --test tests/atlas-packing.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.5.3",
    "@number-flow/react": "^0.6.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@types/three": "^0.185.4",
    "drizzle-orm": "0.45.4",
    "gsap": "^3.15.0",
    "jeep-sqlite": "2.8.0",
    "lucide-react": "^1.41.0",
    "maplibre-gl": "5.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "8.1.2",
    "react-three-map": "1.0.1",
    "tailwindcss": "^4.1.18",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@capacitor/cli": "8.5.3",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "0.31.11",
    "playwright-core": "1.64.1",
    "sql.js": "1.15.1",
    "sql.js-jeep-wasm": "npm:sql.js@1.11.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "2.0.0",
    "wrangler": "^4.130.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
