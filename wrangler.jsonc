{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "threejs",
	"compatibility_date": "2026-09-08",
	"main": "src/worker.ts",
	"observability": { "enabled": true },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		// The Worker maps the entry URL explicitly, so HTML redirects cannot
		// drop the public /beta prefix.
		"html_handling": "none"
	}
}
